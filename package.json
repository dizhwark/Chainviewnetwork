{
  "name": "maybe-marketplace",
  "private": true,
  "version": "0.1.0",
  "description": "MAYBE — Toronto plumbing-services marketplace monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "npm run build --workspace packages/config && npm run build --workspace packages/shared",
    "build:packages": "npm run build --workspace packages/config && npm run build --workspace packages/shared",
    "dev:api": "npm run start:dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace packages/config && npm run build --workspace packages/shared && npm run build --workspace apps/api && npm run build --workspace apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "test": "npm run test --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace apps/api",
    "prisma:migrate": "npm run prisma:migrate --workspace apps/api",
    "seed": "npm run seed --workspace apps/api"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3"
  }
}
