# ============================================================================
# MAYBE — environment configuration
# Copy to .env and fill in. Every external-service var has a documented
# free/local dev fallback — see comments below and docs/architecture.md §8.
# ============================================================================

# --- Branding -----------------------------------------------------------
# Single source of truth is packages/config/src/branding.ts; these override
# it at runtime without a code change (e.g. if the product is renamed).
PRODUCT_NAME="MAYBE"
NEXT_PUBLIC_PRODUCT_NAME="MAYBE"

# --- Core ------------------------------------------------------------------
NODE_ENV=development
APP_TIMEZONE=America/Toronto
APP_CURRENCY=CAD
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Database (PostgreSQL + PostGIS) ---------------------------------------
# Local dev: provided by docker-compose.yml (postgis/postgis image).
DATABASE_URL=postgresql://maybe:maybe@localhost:5432/maybe

# --- Redis (cache, presence, rate limiting, queues) -------------------------
REDIS_URL=redis://localhost:6379

# --- Auth --------------------------------------------------------------
JWT_ACCESS_SECRET=dev-only-change-me-access-secret
JWT_REFRESH_SECRET=dev-only-change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Google/Apple sign-in are architected via AuthProvider abstraction but not
# wired to a live OAuth app until these are set (docs/architecture.md §10.6):
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_SECRET=

# --- Object storage (S3-compatible) -----------------------------------------
# Local dev: MinIO, started by docker-compose.yml, no real AWS account needed.
# Production: point at a real S3-compatible bucket + credentials.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=maybe-uploads
S3_ACCESS_KEY_ID=maybe-dev
S3_SECRET_ACCESS_KEY=maybe-dev-secret
S3_FORCE_PATH_STYLE=true

# --- Payments (Stripe Connect) -----------------------------------------
# Get test keys at https://dashboard.stripe.com/test/apikeys after creating a
# free Stripe account. Without a key set, PAYMENTS_PROVIDER falls back to
# "mock": payment links/checkout sessions are simulated and logged instead of
# calling Stripe, so the app stays fully usable in an offline sandbox.
PAYMENTS_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# --- Maps (Mapbox or Google Maps) -------------------------------------------
# Mapbox: https://account.mapbox.com/access-tokens/ (free tier available)
# Google Maps: https://console.cloud.google.com/google/maps-apis (needs billing
#   enabled even on the free tier).
# Without a key, MAP_PROVIDER falls back to "mock": deterministic canned
# geocoding for common Toronto postal-code prefixes, so address search and
# coverage checks still work in local dev.
MAP_PROVIDER=mock
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAP_PROVIDER=mock
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Email -------------------------------------------------------------
# EMAIL_PROVIDER=console logs emails to the API's stdout — no account needed.
# For a real provider, set EMAIL_PROVIDER=smtp and fill SMTP_* (works with
# Postmark, SendGrid, AWS SES, or any SMTP relay).
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS="MAYBE <no-reply@maybe.example>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- SMS / masked calling (Twilio) — optional, off by default -------------
# https://www.twilio.com/try-twilio for a free trial account.
# SMS_PROVIDER=console logs instead of sending; the feature flag
# FEATURE_SMS_ENABLED must also be true for any SMS to be attempted.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# --- Web Push (VAPID) --------------------------------------------------
# Generate locally with: npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@maybe.example

# --- Error monitoring (Sentry-compatible) -----------------------------------
# https://sentry.io — free tier available. Leave blank to log locally instead.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Feature flags (defaults; can be overridden per-environment in the admin
#     portal once seeded — see packages/config/src/feature-flags.ts) --------
FEATURE_LIVE_GPS=false
FEATURE_AUTO_MATCHING=false
FEATURE_CUSTOMER_PLUMBER_SELECTION=true
FEATURE_SUBSCRIPTIONS=false
FEATURE_FEATURED_PLACEMENT=false
FEATURE_EMERGENCY_FEES=true
FEATURE_TIPS=false
FEATURE_SMS=false
FEATURE_MASKED_CALLING=false
FEATURE_CUSTOMER_REFUNDS_CREDIT=false
FEATURE_SCHEDULED_BOOKINGS=true
FEATURE_NATIVE_PUSH=false
FEATURE_MULTI_ZONE=false

# --- Admin bootstrap (local/dev only — never set a default password in
#     production; the seed script refuses to run with NODE_ENV=production) --
SEED_ADMIN_EMAIL=admin@maybe.example
SEED_ADMIN_PASSWORD=ChangeMe123!
